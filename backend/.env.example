# Obaidi Time - backend environment
# Copy to .env and fill in. NEVER commit a real .env.

ENVIRONMENT=development

# PostgreSQL in staging/production:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/obaidi_time
# SQLite is supported for local development only.
DATABASE_URL=sqlite:///./obaidi_time.db

# Signs the admin session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# Set to true once the API is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Used by `python -m app.seed` to create the first admin. Not read at runtime.
ADMIN_EMAIL=admin@retrowatches.jo
ADMIN_PASSWORD=

# Where the payment provider returns the customer to.
STOREFRONT_URL=http://localhost:3000

# Payments. Leave as "unconfigured" and the whole payment path returns 503,
# which is the safe default. Set to "stripe" with real keys to switch it on,
# and point the provider's webhook at POST /api/payments/webhook/stripe.
PAYMENT_PROVIDER=unconfigured
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
